# ============================================================
# KERNSCHMIED - KONFIGURATIONSVORLAGE
# ============================================================
# Kopiere diese Datei nach .env und passe die Werte an.

# Betriebsprofil: development | intranet | internet
APP_ENV=development

# Server-Bindung
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Datenbank (SQLite für Entwicklung)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/chat.db

# Sicherheit (MUSS für Produktion geändert werden!)
# HINWEIS: Diese Werte dürfen nicht im Repository landen. Kopiere diese
# Datei nach .env und fülle die Felder mit sicheren Geheimnissen.
#
# - `SECRET_KEY`: Wird für Sitzungs-Cookies und Signaturen verwendet.
#   Muss mindestens 32 Zeichen lang sein. Erzeuge z.B. mit:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# - `CONFIG_ENCRYPTION_KEY`: Symmetrischer Schlüssel zum Verschlüsseln
#   sensibler Konfigdaten. Ebenfalls mindestens 32 Zeichen.
#
# - `BOOTSTRAP_ADMIN_TOKEN`: Optionaler einmaliger Token zum Initial-Setup.

SECRET_KEY=
CONFIG_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_TOKEN=

# Proxy & TLS
TRUSTED_PROXY_COUNT=0
BOOTSTRAP_CONFIG_FILE=./config/bootstrap.json
TLS_CERT_FILE=
TLS_KEY_FILE=

# Admin-Token (für Entwicklung deaktiviert)
BOOTSTRAP_ADMIN_TOKEN_ENABLED=false

# Beispiel: Schlüssel mit Python generieren
# python -c "import secrets; print('SECRET_KEY='+secrets.token_urlsafe(48))"
# python -c "import secrets; print('CONFIG_ENCRYPTION_KEY='+secrets.token_urlsafe(48))"

# Sicherheitshinweis: Stelle sicher, dass deine .env in .gitignore steht
# (standardmäßig enthalten). Verwende für Produktion ein Secret-Management
# System (Azure Key Vault, AWS Secrets Manager, HashiCorp Vault, etc.).