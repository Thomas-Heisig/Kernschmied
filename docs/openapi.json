{
  "openapi": "3.1.0",
  "info": {
    "title": "Kernschmied",
    "description": "Modulare, schema-gesteuerte Chat-Anwendung mit versionierten API-Verträgen.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["System / Health"],
        "summary": "Health Check",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap": {
      "get": {
        "tags": ["System / Bootstrap"],
        "summary": "Frontend-Bootstrap laden",
        "description": "Liefert die initialen, nicht sensiblen Laufzeitinformationen für das schema-gesteuerte Frontend. Der Bootstrap ersetzt keine serverseitige Autorisierung.",
        "operationId": "bootstrap_api_v1_bootstrap_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BootstrapResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ui/schema": {
      "get": {
        "tags": ["UI / Schema"],
        "summary": "UI-Schema laden",
        "description": "Liefert den versionierten, schema-gesteuerten UI-Vertrag. Das Frontend darf ausschließlich bekannte Komponenten- und Aktionstypen aus seinen festen Registries ausführen.",
        "operationId": "ui_schema_api_v1_ui_schema_get",
        "parameters": [
          {
            "name": "include_disabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Deaktivierte Schemaelemente mit ausgeben. Für administrative Ansichten vorgesehen.",
              "default": false,
              "title": "Include Disabled"
            },
            "description": "Deaktivierte Schemaelemente mit ausgeben. Für administrative Ansichten vorgesehen."
          }
        ],
        "responses": {
          "200": {
            "description": "Das UI-Schema wurde erfolgreich erzeugt.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UISchemaResponse" }
              }
            }
          },
          "500": { "description": "Das erzeugte UI-Schema ist ungültig." },
          "503": {
            "description": "Der UI-Schema-Builder ist nicht verfügbar."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": ["Hierarchy"],
        "summary": "Hierarchie laden",
        "description": "Liefert die generische Projekt-/Mandanten-/Objekthierarchie für das schema-gesteuerte Frontend.",
        "operationId": "hierarchy_api_v1_hierarchy_get",
        "parameters": [
          {
            "name": "root_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "description": "Optionaler Startknoten.",
              "title": "Root Id"
            },
            "description": "Optionaler Startknoten."
          },
          {
            "name": "max_depth",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                { "type": "integer", "maximum": 32, "minimum": 1 },
                { "type": "null" }
              ],
              "description": "Optionale maximale Rekursionstiefe.",
              "title": "Max Depth"
            },
            "description": "Optionale maximale Rekursionstiefe."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyTreeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": ["Registry / Models"],
        "summary": "Verfügbare Modelle auflisten",
        "description": "Liefert die serverseitig registrierten und für das Frontend sichtbaren Modelle. Die Sichtbarkeit ersetzt keine Autorisierung bei einer späteren Modellauswahl.",
        "operationId": "models_api_v1_models_get",
        "parameters": [
          {
            "name": "include_disabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Deaktivierte Modelle mit ausgeben. Für Admin-Oberflächen vorgesehen.",
              "default": false,
              "title": "Include Disabled"
            },
            "description": "Deaktivierte Modelle mit ausgeben. Für Admin-Oberflächen vorgesehen."
          },
          {
            "name": "capability",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "chat",
                    "streaming",
                    "tool_calling",
                    "vision",
                    "embeddings",
                    "structured_output"
                  ],
                  "type": "string"
                },
                { "type": "null" }
              ],
              "description": "Optional nach einer Fähigkeit filtern.",
              "title": "Capability"
            },
            "description": "Optional nach einer Fähigkeit filtern."
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 100 },
                { "type": "null" }
              ],
              "description": "Optional nach Provider filtern.",
              "title": "Provider"
            },
            "description": "Optional nach Provider filtern."
          }
        ],
        "responses": {
          "200": {
            "description": "Modellliste wurde geladen.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModelListResponse" }
              }
            }
          },
          "503": {
            "description": "Die Modellregistrierung ist nicht verfügbar."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "tags": ["Registry / Tools"],
        "summary": "Verfügbare Tools auflisten",
        "description": "Liefert die registrierten und für das Frontend sichtbaren Tools. Die Listung eines Tools stellt keine Ausführungsfreigabe dar.",
        "operationId": "tools_api_v1_tools_get",
        "parameters": [
          {
            "name": "include_disabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Deaktivierte Tools mit ausgeben. Für administrative Oberflächen vorgesehen.",
              "default": false,
              "title": "Include Disabled"
            },
            "description": "Deaktivierte Tools mit ausgeben. Für administrative Oberflächen vorgesehen."
          },
          {
            "name": "include_unavailable",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Aktuell nicht verfügbare Tools mit ausgeben.",
              "default": false,
              "title": "Include Unavailable"
            },
            "description": "Aktuell nicht verfügbare Tools mit ausgeben."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 100 },
                { "type": "null" }
              ],
              "description": "Optional nach Tool-Kategorie filtern.",
              "title": "Category"
            },
            "description": "Optional nach Tool-Kategorie filtern."
          },
          {
            "name": "capability",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "streaming",
                    "confirmation_required",
                    "idempotent",
                    "read_only",
                    "supports_cancellation"
                  ],
                  "type": "string"
                },
                { "type": "null" }
              ],
              "description": "Optional nach einer Fähigkeit filtern.",
              "title": "Capability"
            },
            "description": "Optional nach einer Fähigkeit filtern."
          }
        ],
        "responses": {
          "200": {
            "description": "Tool-Liste wurde geladen.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ToolListResponse" }
              }
            }
          },
          "503": { "description": "Die Tool-Registry ist nicht verfügbar." },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/stream": {
      "post": {
        "tags": ["Chat"],
        "summary": "Chat-Antwort streamen",
        "description": "Erzeugt eine Chat-Antwort als versionierten Server-Sent-Events-Datenstrom.",
        "operationId": "stream_chat_api_v1_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE-Datenstrom wurde gestartet.",
            "content": {
              "application/json": { "schema": {} },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "422": { "description": "Die Chat-Anfrage ist ungültig." },
          "503": {
            "description": "Der produktive ChatService ist nicht verfügbar."
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": ["Administration / Configuration"],
        "summary": "Konfiguration auflisten",
        "description": "Liefert die sichtbare Fachkonfiguration und die aktuelle Revision. Sensible Werte werden nicht ausgegeben.",
        "operationId": "list_config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConfigListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/{group}/{key}": {
      "put": {
        "tags": ["Administration / Configuration"],
        "summary": "Konfigurationswert ändern",
        "description": "Ändert einen runtime-editierbaren Konfigurationswert. Die Änderung muss durch den ConfigService validiert, versioniert und protokolliert werden.",
        "operationId": "update_config_api_v1_config__group___key__put",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Group" }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Key" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfigUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Konfiguration wurde aktualisiert.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigUpdateResponse"
                }
              }
            }
          },
          "403": { "description": "Keine Berechtigung für die Änderung." },
          "409": {
            "description": "Die Konfiguration wurde zwischenzeitlich geändert."
          },
          "422": { "description": "Gruppe, Schlüssel oder Wert ist ungültig." }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Anwendungsstatus",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BootstrapApplication": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "version": { "type": "string", "title": "Version" },
          "environment": {
            "type": "string",
            "enum": ["development", "intranet", "internet"],
            "title": "Environment"
          },
          "api_prefix": { "type": "string", "title": "Api Prefix" }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "version", "environment", "api_prefix"],
        "title": "BootstrapApplication",
        "description": "Grundinformationen über die laufende Anwendung."
      },
      "BootstrapCapabilities": {
        "properties": {
          "hierarchy": {
            "type": "boolean",
            "title": "Hierarchy",
            "default": false
          },
          "ui_schema": {
            "type": "boolean",
            "title": "Ui Schema",
            "default": false
          },
          "chat_streaming": {
            "type": "boolean",
            "title": "Chat Streaming",
            "default": false
          },
          "chat_persistence": {
            "type": "boolean",
            "title": "Chat Persistence",
            "default": false
          },
          "model_registry": {
            "type": "boolean",
            "title": "Model Registry",
            "default": false
          },
          "model_service": {
            "type": "boolean",
            "title": "Model Service",
            "default": false
          },
          "tool_registry": {
            "type": "boolean",
            "title": "Tool Registry",
            "default": false
          },
          "configuration": {
            "type": "boolean",
            "title": "Configuration",
            "default": false
          },
          "configuration_admin": {
            "type": "boolean",
            "title": "Configuration Admin",
            "default": false
          },
          "file_upload": {
            "type": "boolean",
            "title": "File Upload",
            "default": false
          },
          "audit_log": {
            "type": "boolean",
            "title": "Audit Log",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BootstrapCapabilities",
        "description": "Technische Verfügbarkeit von Modulen.\n\nDiese Werte sind keine Berechtigungsentscheidung. Jeder aufgerufene\nEndpunkt muss die jeweilige Benutzeraktion erneut serverseitig\nautorisieren."
      },
      "BootstrapEndpoints": {
        "properties": {
          "bootstrap": { "type": "string", "title": "Bootstrap" },
          "ui_schema": { "type": "string", "title": "Ui Schema" },
          "hierarchy": { "type": "string", "title": "Hierarchy" },
          "chat_stream": { "type": "string", "title": "Chat Stream" },
          "chats": { "type": "string", "title": "Chats" },
          "configuration": { "type": "string", "title": "Configuration" },
          "models": { "type": "string", "title": "Models" },
          "tools": { "type": "string", "title": "Tools" },
          "health_live": { "type": "string", "title": "Health Live" },
          "health_ready": { "type": "string", "title": "Health Ready" }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bootstrap",
          "ui_schema",
          "hierarchy",
          "chat_stream",
          "chats",
          "configuration",
          "models",
          "tools",
          "health_live",
          "health_ready"
        ],
        "title": "BootstrapEndpoints",
        "description": "Zentrale API-Einstiegspunkte für das Frontend.\n\nDie Pfade werden aus dem tatsächlich konfigurierten API-Prefix\nerzeugt und nicht mehrfach im Frontend fest verdrahtet."
      },
      "BootstrapFeatures": {
        "properties": {
          "schema_driven_ui": {
            "type": "boolean",
            "title": "Schema Driven Ui",
            "default": true
          },
          "recursive_hierarchy": {
            "type": "boolean",
            "title": "Recursive Hierarchy",
            "default": true
          },
          "server_side_authorization": {
            "type": "boolean",
            "title": "Server Side Authorization",
            "default": true
          },
          "streaming_transport": {
            "type": "string",
            "const": "sse",
            "title": "Streaming Transport",
            "default": "sse"
          },
          "dynamic_models": {
            "type": "boolean",
            "title": "Dynamic Models",
            "default": false
          },
          "dynamic_tools": {
            "type": "boolean",
            "title": "Dynamic Tools",
            "default": false
          },
          "runtime_configuration": {
            "type": "boolean",
            "title": "Runtime Configuration",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BootstrapFeatures",
        "description": "Für das Frontend sichtbare technische Betriebsmerkmale."
      },
      "BootstrapResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.1"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "v1"
          },
          "application": {
            "$ref": "#/components/schemas/BootstrapApplication"
          },
          "environment": {
            "type": "string",
            "enum": ["development", "intranet", "internet"],
            "title": "Environment"
          },
          "user": { "$ref": "#/components/schemas/BootstrapUser" },
          "security_profile": {
            "additionalProperties": true,
            "type": "object",
            "title": "Security Profile"
          },
          "capabilities": {
            "$ref": "#/components/schemas/BootstrapCapabilities"
          },
          "features": { "$ref": "#/components/schemas/BootstrapFeatures" },
          "versions": { "$ref": "#/components/schemas/BootstrapVersions" },
          "endpoints": { "$ref": "#/components/schemas/BootstrapEndpoints" },
          "revisions": { "$ref": "#/components/schemas/BootstrapRevisions" },
          "config_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Config Revision"
          },
          "request_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Request Id"
          },
          "minimum_client_version": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Minimum Client Version",
            "description": "Erforderliche Mindestversion des Frontends."
          },
          "feature_flags": {
            "anyOf": [
              {
                "additionalProperties": { "type": "boolean" },
                "type": "object"
              },
              { "type": "null" }
            ],
            "title": "Feature Flags",
            "description": "Feature-Flags für das Frontend."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "application",
          "environment",
          "user",
          "security_profile",
          "capabilities",
          "features",
          "versions",
          "endpoints",
          "revisions",
          "config_revision"
        ],
        "title": "BootstrapResponse",
        "description": "Stabiler und versionierter Bootstrap-Vertrag."
      },
      "BootstrapRevisions": {
        "properties": {
          "configuration": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Configuration",
            "default": 0
          },
          "model_registry": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Model Registry",
            "default": 0
          },
          "tool_registry": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tool Registry",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BootstrapRevisions",
        "description": "Revisionsstände für Cache-Invalidierung und Diagnose."
      },
      "BootstrapUser": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "roles": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Roles"
          },
          "permissions": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Permissions"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "name"],
        "title": "BootstrapUser",
        "description": "Minimale, frontendfähige Darstellung des aktuellen Benutzers.\n\nEs werden keine Session-Tokens, Passwortdaten oder internen\nAuthentifizierungsinformationen ausgegeben."
      },
      "BootstrapVersions": {
        "properties": {
          "bootstrap_schema": {
            "type": "string",
            "title": "Bootstrap Schema",
            "default": "1.1"
          },
          "ui_schema": {
            "type": "string",
            "title": "Ui Schema",
            "default": "1.0"
          },
          "hierarchy_schema": {
            "type": "string",
            "title": "Hierarchy Schema",
            "default": "1.0"
          },
          "chat_schema": {
            "type": "string",
            "title": "Chat Schema",
            "default": "1.0"
          },
          "model_schema": {
            "type": "string",
            "title": "Model Schema",
            "default": "1.0"
          },
          "tool_schema": {
            "type": "string",
            "title": "Tool Schema",
            "default": "1.0"
          },
          "api": { "type": "string", "title": "Api", "default": "v1" }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BootstrapVersions",
        "description": "Versionen der stabilen Backend- und Frontend-Verträge."
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message",
            "description": "Nachricht des Benutzers."
          },
          "conversation_id": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ],
            "title": "Conversation Id",
            "description": "Bestehende Unterhaltung, falls vorhanden."
          },
          "hierarchy_node_id": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ],
            "title": "Hierarchy Node Id",
            "description": "Aktiver generischer Hierarchieknoten."
          },
          "model_id": {
            "anyOf": [
              { "type": "string", "maxLength": 255, "minLength": 1 },
              { "type": "null" }
            ],
            "title": "Model Id",
            "description": "Optional angefordertes Modell."
          },
          "tool_ids": {
            "items": { "type": "string" },
            "type": "array",
            "maxItems": 100,
            "title": "Tool Ids",
            "description": "Optional angeforderte Tool-IDs."
          },
          "metadata": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Metadata",
            "description": "Nicht sicherheitskritische Client-Metadaten."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["message"],
        "title": "ChatRequest",
        "description": "Eingabevertrag für eine Chat-Anfrage.\n\nModell- und Tool-IDs sind ausschließlich Benutzerwünsche. Auswahl,\nFreigabe und Autorisierung erfolgen serverseitig."
      },
      "ConfigEntryResponse": {
        "properties": {
          "group": { "type": "string", "title": "Group" },
          "key": { "type": "string", "title": "Key" },
          "value": { "$ref": "#/components/schemas/JsonValue" },
          "editable": {
            "type": "boolean",
